  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;
using System.Text.RegularExpressions;

namespace FastReport
{
  public class ReportScript
  {
    public static string AplicarMascaraDeDocumento(string conteudo, bool mascarar)
    {
      if (conteudo.Length &lt;= 11)
        return AplicarMascaraDeCPF(conteudo, mascarar);
      else
        return AplicarMascaraDeCNPJ(conteudo, mascarar);
    }

    public static string ExtrairCaracteresNumericos(string conteudo)
    {
      return String.Join(&quot;&quot;, Regex.Split(conteudo, @&quot;[^\d]&quot;));
    }
  
    private static string AplicarMascaraDeCNPJ(string cnpj, bool mascarar)
    {
      string cnpjComMascara = string.Empty;
  
      if (mascarar)
      {
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(0, 2);
        cnpjComMascara += &quot;.&quot;;
        cnpjComMascara += &quot;XXX&quot;;
        cnpjComMascara += &quot;.&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(5, 2);
        cnpjComMascara += &quot;X&quot;;
        cnpjComMascara += &quot;/&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(8, 4);
        cnpjComMascara += &quot;-&quot;;
        cnpjComMascara += &quot;XX&quot;;
      }
      else
      {
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(0, 2);
        cnpjComMascara += &quot;.&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(2, 3);
        cnpjComMascara += &quot;.&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(5, 3);
        cnpjComMascara += &quot;/&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(8, 4);
        cnpjComMascara += &quot;-&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(12, 2);
      }
      return cnpjComMascara;
    }
  
    private static string AplicarMascaraDeCPF(string cpf, bool mascarar)
    {
      string cpfComMascara = string.Empty;
  
      if (mascarar)
      {
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(0, 3);
        cpfComMascara += &quot;.&quot;;
        cpfComMascara += &quot;XXX&quot;;
        cpfComMascara += &quot;.&quot;;
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(6, 3);
        cpfComMascara += &quot;-&quot;;
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(9, 1);
        cpfComMascara += &quot;X&quot;;
      }
      else
      {
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(0, 3);
        cpfComMascara += &quot;.&quot;;
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(3, 3);
        cpfComMascara += &quot;.&quot;;
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(6, 3);
        cpfComMascara += &quot;-&quot;;
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(9, 2);
      }
      return cpfComMascara;
    }  
  
    private void Text459_AfterData(object sender, EventArgs e)    {
      
      Text459.Text = &quot;&lt;b&gt;Protocolo&lt;/b&gt;\n &quot; + (((Int32)Report.GetColumnValue(&quot;Dados.Apontamentos.NumeroDoProtocolo&quot;)).ToString().PadLeft(4,'0') + &quot; - &quot; + ((DateTime)Report.GetColumnValue(&quot;Dados.Apontamentos.DataDoProtocolo&quot;)).ToString(&quot;dd/MM/yyyy&quot;));    
    }
    
   
    private void Text391_AfterData(object sender, EventArgs e)
    {
      Text391.Text = ((String)Report.GetColumnValue(&quot;Dados.Boleto.DadosDoBoletoObject.Sacado&quot;)) + &quot;  &quot; + 
        ((String)Report.GetColumnValue(&quot;Dados.Boleto.DadosDoBoletoObject.TipoDeDocumentoDoSacado&quot;)) + &quot; &quot; + 
        AplicarMascaraDeDocumento(((String)Report.GetColumnValue(&quot;Dados.Boleto.DadosDoBoletoObject.NumeroDoDocumentoDoSacado&quot;)), false);  
    }

    
    private void Text399_AfterData(object sender, EventArgs e)
    {
      Text399.Text = (((Int32)Report.GetColumnValue(&quot;Dados.Apontamentos.NumeroDoProtocolo&quot;)).ToString().PadLeft(4,'0') + &quot; - &quot; + ((DateTime)Report.GetColumnValue(&quot;Dados.Apontamentos.DataDoProtocolo&quot;)).ToString(&quot;dd/MM/yyyy&quot;));    
    }    

  

    private void Text4_AfterData(object sender, EventArgs e)
    {
      
      if (((Nullable&lt;Guid&gt;)Report.GetColumnValue(&quot;Dados.Apontamentos.Titulo.VencimentoID&quot;)) != null)
        Text4.Text = &quot;&lt;b&gt;Vencimento&lt;/b&gt;\r\n&quot; + ((String)Report.GetColumnValue(&quot;Dados.Apontamentos.Titulo.Vencimento.Nome&quot;));
      else
        Text4.Text = &quot;&lt;b&gt;Vencimento&lt;/b&gt;\r\n&quot; + ((DateTime)Report.GetColumnValue(&quot;Dados.Apontamentos.Titulo.DataDeVencimento&quot;)).ToString(&quot;dd/MM/yyyy&quot;);
    }

    private void Text455_AfterData(object sender, EventArgs e)
    {
      Text455.Text = &quot;&lt;b&gt;&quot; + ((String)Report.GetColumnValue(&quot;Dados.DadosDoSacado.Pessoa.TipoDeDocumento&quot;)) + &quot;: &lt;/b&gt;&quot;
        + AplicarMascaraDeDocumento(((Int64)Report.GetColumnValue(&quot;Dados.DadosDoSacado.Pessoa.NumeroDoDocumento&quot;)).ToString(),false);
    }

    private void Text468_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetColumnValue(&quot;Dados.Apontamentos.TipoDeProtesto&quot;)) == &quot;C&quot;)
        Text468.Text = &quot;&lt;b&gt;Tipo de Protesto&lt;/b&gt;\nCOMUM&quot;;
      else if (((String)Report.GetColumnValue(&quot;Dados.Apontamentos.TipoDeProtesto&quot;)) == &quot;F&quot;)
        Text468.Text = &quot;&lt;b&gt;Tipo de Protesto&lt;/b&gt;\nFALIMENTAR&quot;;
      
      if (((Boolean)Report.GetColumnValue(&quot;Dados.Apontamentos.ProtestoComDireitoDeRegresso&quot;)) == true)
        Text468.Text = &quot;&lt;b&gt;Tipo de Protesto&lt;/b&gt;\nCOMUM COM DIREITO DE REGRESSO&quot;;    
    }

    private void Text456_AfterData(object sender, EventArgs e)
    {
      if(String.IsNullOrEmpty(((String)Report.GetColumnValue(&quot;Dados.EnderecoDoSacado.Endereco&quot;)))){
        Child3.Visible = false;
        Text392.Visible = false;
      }        
      else
      {
        Child3.Visible = true;
        Text392.Visible = true;
      }
    }  

    private void Text471_AfterData(object sender, EventArgs e)
    {
      Text471.Text += ((String)Report.GetColumnValue(&quot;Dados.CredoresDoTitulo.Pessoa.TipoDeDocumento&quot;)) + &quot;: &quot; + AplicarMascaraDeDocumento(((Int64)Report.GetColumnValue(&quot;Dados.CredoresDoTitulo.Pessoa.NumeroDoDocumento&quot;)).ToString(), false);
    }

    private void Text666_AfterData(object sender, EventArgs e)
    {
      if(String.IsNullOrEmpty((String)Report.GetColumnValue(&quot;Dados.Apontamentos.IdentificacaoDaDivida&quot;)))
      {
       Text666.Visible = false;
      }
    }
  }
}
</ScriptText>
