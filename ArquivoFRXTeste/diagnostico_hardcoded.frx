  public class ReportScript
  {       
    public static string AplicarMascaraDeDocumento(string tipo, string conteudo, bool mascarar)
    {
      if (conteudo.Length &lt;= 11 &amp;&amp; tipo == &quot;CPF&quot;)
        return AplicarMascaraDeCPF(conteudo, mascarar);
      else
        return AplicarMascaraDeCNPJ(conteudo, mascarar);
    }

    public static string ExtrairCaracteresNumericos(string conteudo)
    {
      return String.Join(&quot;&quot;, Regex.Split(conteudo, @&quot;[^\d]&quot;));
    }
  
    private static string AplicarMascaraDeCNPJ(string cnpj, bool mascarar)
    {
      string cnpjComMascara = string.Empty;
  
      if (mascarar)
      {
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(0, 2);
        cnpjComMascara += &quot;.&quot;;
        cnpjComMascara += &quot;XXX&quot;;
        cnpjComMascara += &quot;.&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(5, 2);
        cnpjComMascara += &quot;X&quot;;
        cnpjComMascara += &quot;/&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(8, 4);
        cnpjComMascara += &quot;-&quot;;
        cnpjComMascara += &quot;XX&quot;;
      }
      else
      {
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(0, 2);
        cnpjComMascara += &quot;.&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(2, 3);
        cnpjComMascara += &quot;.&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(5, 3);
        cnpjComMascara += &quot;/&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(8, 4);
        cnpjComMascara += &quot;-&quot;;
        cnpjComMascara += ExtrairCaracteresNumericos(cnpj).PadLeft(14, '0').Substring(12, 2);
      }
      return cnpjComMascara;
    }
  
    private static string AplicarMascaraDeCPF(string cpf, bool mascarar)
    {
      string cpfComMascara = string.Empty;
  
      if (mascarar)
      {
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(0, 3);
        cpfComMascara += &quot;.&quot;;
        cpfComMascara += &quot;XXX&quot;;
        cpfComMascara += &quot;.&quot;;
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(6, 3);
        cpfComMascara += &quot;-&quot;;
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(9, 1);
        cpfComMascara += &quot;X&quot;;
      }
      else
      {
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(0, 3);
        cpfComMascara += &quot;.&quot;;
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(3, 3);
        cpfComMascara += &quot;.&quot;;
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(6, 3);
        cpfComMascara += &quot;-&quot;;
        cpfComMascara += ExtrairCaracteresNumericos(cpf).PadLeft(11, '0').Substring(9, 2);
      }
      return cpfComMascara;
    } 
    
    public static string AplicarMascaraDeCep(string cep)
    {
      if(!string.IsNullOrEmpty(cep))
      {
        cep = cep.PadLeft(8, '0');
        return cep.Substring(0,5) + &quot;-&quot; + cep.Substring(5,3);
      }
      else return cep;
    }
         
    private void Text453_AfterData(object sender, EventArgs e)
    {
      Text453.Text = ((Int32)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoTitulo.NumeroDoProtocolo&quot;)).ToString().PadLeft(4,'0') + &quot; - &quot; + ((DateTime)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoTitulo.DataDoProtocolo&quot;)).ToString(&quot;dd/MM/yyyy&quot;);    
      Text449.Text = ((Int32)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoTitulo.NumeroDoProtocolo&quot;)).ToString().PadLeft(4,'0') + &quot; - &quot; + ((DateTime)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoTitulo.DataDoProtocolo&quot;)).ToString(&quot;dd/MM/yyyy&quot;);  
      Text399.Text = ((Int32)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoTitulo.NumeroDoProtocolo&quot;)).ToString().PadLeft(4,'0') + &quot; - &quot; + ((DateTime)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoTitulo.DataDoProtocolo&quot;)).ToString(&quot;dd/MM/yyyy&quot;);    
    }

    private void Text423_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoTitulo.TipoDoProtesto&quot;)) == &quot;C&quot;)
        Text423.Text = &quot;COMUM&quot;;
      else if (((String)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoTitulo.TipoDoProtesto&quot;))  == &quot;F&quot;)
        Text423.Text = &quot;FALIMENTAR&quot;;
      
      if (((Boolean)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoTitulo.ProtestoComDireitoDeRegresso&quot;)) == true)
        Text423.Text = &quot;COMUM COM DIREITO DE REGRESSO&quot;;
    }

    private void Text9_AfterData(object sender, EventArgs e)
    {
      Text9.Text = (&quot;&lt;b&gt;&quot; + ((String)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoDevedor.Qualificacao&quot;)) + &quot;&lt;/b&gt;: &quot; +
        ((String)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoDevedor.Nome&quot;)) + &quot;  &quot; + ((String)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoDevedor.TipoDeDocumento&quot;)) + &quot; &quot; +
        AplicarMascaraDeDocumento(((String)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoDevedor.TipoDeDocumento&quot;)),((Int64)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoDevedor.NumeroDoDocumento&quot;)).ToString(),false));  
    }
        
    private void Text417_AfterData(object sender, EventArgs e)    
