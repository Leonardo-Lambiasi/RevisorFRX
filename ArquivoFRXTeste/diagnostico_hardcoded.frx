        if (((String)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoDevedor.TelefoneDoDevedor.Origem&quot;)) == &quot;Avise Me&quot;)
          Text711.Text += &quot; - Av &quot;;
