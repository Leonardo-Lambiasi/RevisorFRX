  <ReportPage Name="Page1" RawPaperSize="9" TopMargin="8" BottomMargin="0">
    <DataBand Name="Data1" Width="718.2" Height="800" CanGrow="true" DataSource="BusinessObjectDataSource1">

      <!-- ===== GRUPO A: Detectável por regex estrutural ===== -->

      <!-- A1: CNPJ fixo do cartório de origem -->
      <TextObject Name="txtHardCNPJ"
        Left="10" Top="10" Width="200" Height="18"
        Text="CNPJ: 04.123.456/0001-78"/>

      <!-- A2: Telefone fixo -->
      <TextObject Name="txtHardTelefone"
        Left="10" Top="30" Width="200" Height="18"
        Text="Tel: (11) 3456-7890 / (11) 98765-4321"/>

      <!-- A3: CEP fixo -->
      <TextObject Name="txtHardCEP"
        Left="10" Top="50" Width="200" Height="18"
        Text="CEP: 01310-100"/>

      <!-- A4: Data literal fixa -->
      <TextObject Name="txtHardData"
        Left="10" Top="70" Width="200" Height="18"
        Text="São Paulo, 15/03/2024"/>

      <!-- A5: Valor monetário fixo -->
      <TextObject Name="txtHardValor"
        Left="10" Top="90" Width="200" Height="18"
        Text="Taxa de Implantação: R$ 127,84"/>

      <!-- A6: Ordinal de cartório -->
      <TextObject Name="txtHardNomeCartorio"
        Left="10" Top="110" Width="300" Height="18"
        Text="4º Tabelionato de Protestos de São Paulo"/>

      <!-- A7: Agência bancária fixa -->
      <TextObject Name="txtHardAgencia"
        Left="10" Top="130" Width="300" Height="18"
        Text="Banco do Brasil - Agência 1234-5 / CC 56789-0"/>

      <!-- A8: CPF fixo (tabelião) -->
      <TextObject Name="txtHardCPF"
        Left="10" Top="150" Width="200" Height="18"
        Text="CPF: 123.456.789-00"/>

      <!-- ===== GRUPO B: NÃO detectável por regex (texto livre) ===== -->

      <!-- B1: Nome do tabelião fixo -->
      <TextObject Name="txtHardTabeliao"
        Left="10" Top="170" Width="300" Height="18"
        Text="Dr. João Carlos Silva — Tabelião Titular"/>

      <!-- B2: Endereço sem CEP -->
      <TextObject Name="txtHardEndereco"
        Left="10" Top="190" Width="300" Height="18"
        Text="Rua Boa Vista, 254 — Centro — São Paulo/SP"/>

      <!-- B3: Complemento curto sem padrão -->
      <TextObject Name="txtHardComplemento"
        Left="10" Top="210" Width="200" Height="18"
        Text="Sala 42 — 4º andar"/>

      <!-- B4: Texto misto — label + valor fixo errado -->
      <TextObject Name="txtHardMisto"
        Left="10" Top="230" Width="400" Height="18"
        Text="Cartório: 4º Tabelionato — Responsável: Dr. João Silva"/>

      <!-- B5: Município fixo -->
      <TextObject Name="txtHardMunicipio"
        Left="10" Top="250" Width="150" Height="18"
        Text="São Paulo"/>

      <!-- ===== GRUPO C: PictureObjects ===== -->

      <!-- C1: Logo embutido em base64 — NÃO vem do schema -->
      <PictureObject Name="imgHardLogo"
        Left="500" Top="10" Width="94.5" Height="47.25"
        DataColumn=""
        Image="iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="/>

      <!-- C2: Logo correto via DataColumn -->
      <PictureObject Name="imgLogoCorreto"
        Left="500" Top="70" Width="94.5" Height="47.25"
        DataColumn="Dados.DadosDoCartorio.Logo"/>

      <!-- ===== GRUPO D: Controles (NÃO devem ser flagados) ===== -->

      <!-- D1: Expressão correta — campo do schema -->
      <TextObject Name="txtCorretoNome"
        Left="10" Top="300" Width="300" Height="18"
        Text="[Dados.DadosDoCartorio.Nome]"/>

      <!-- D2: Label puro -->
      <TextObject Name="txtLabelProtocolo"
        Left="10" Top="320" Width="100" Height="18"
        Text="Protocolo:"/>

      <!-- D3: Texto misto correto — label + expressão -->
      <TextObject Name="txtMistoCorreto"
        Left="10" Top="340" Width="300" Height="18"
        Text="Cartório: [Dados.DadosDoCartorio.Nome]"/>

      <!-- D4: Texto legal institucional — zona cinza -->
      <TextObject Name="txtLegal"
        Left="10" Top="360" Width="500" Height="18"
        Text="Certifico e dou fé que o presente instrumento é cópia fiel do original."/>

      <!-- D5: Ordinal em contexto de label — não é hardcoded de cartório -->
      <TextObject Name="txtLabelOrdinal"
        Left="10" Top="380" Width="100" Height="18"
        Text="1º Via"/>

    </DataBand>
  </ReportPage>
</Report>
