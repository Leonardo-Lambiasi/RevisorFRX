    private void Text6_AfterData(object sender, EventArgs e)
    {
      Text6.Text = (((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Devedores.Participante.Pessoa.TipoDeDocumento&quot;)) + &quot; &quot; + AplicarMascaraDeDocumento(((Int64)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Devedores.Participante.Pessoa.NumeroDoDocumento&quot;)).ToString(), false));  
    }

    private void Text383_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.TipoDeProtesto&quot;))== &quot;C&quot;)
        Text383.Text = &quot;Comum&quot;; 
      else if (((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.TipoDeProtesto&quot;)) == &quot;F&quot;)
        Text383.Text = &quot;Falimentar&quot;; 
      else if (((Boolean)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.ProtestoComDireitoDeRegresso&quot;)) == true)
        Text383.Text = &quot;Comum com Direito de Regresso&quot;;   
    }

    private void Text391_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Titulo.Endosso&quot;)) == &quot;S&quot;)
        Text391.Text = &quot;Sem Endosso&quot;;  
      else if (((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Titulo.Endosso&quot;)) == &quot;T&quot;)
        Text391.Text = &quot;Translativo&quot;;  
      else if (((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Titulo.Endosso&quot;)) == &quot;M&quot;)
        Text391.Text = &quot;Mandato&quot;;   
    }

    private void Text389_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Devedores.Declaracao&quot;)).Trim() != string.Empty)
        Text389.Text = &quot;Consta Declaração&quot;;
      else
        Text389.Text = &quot;Não Consta&quot;;
    }

    private void Text3_AfterData(object sender, EventArgs e)
    {
      if (((Boolean)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.VerbasTotais.Cobrar&quot;)))
        Text3.Text = (&quot;R$ &quot; + ((Decimal)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.VerbasTotais.Valor&quot;)).ToString(&quot;N2&quot;));   
      else
        Text3.Text = &quot;R$ 0,00&quot;;
    }

    private void Text387_AfterData(object sender, EventArgs e)
    {
      if (((Nullable&lt;Guid&gt;)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Titulo.VencimentoID&quot;)) != null)
        Text387.Text = ((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Titulo.Vencimento.Nome&quot;));
      else
        Text387.Text = ((DateTime)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Titulo.DataDeVencimento&quot;)).ToString(&quot;dd/MM/yyyy&quot;);
    }

    private void Text405_AfterData(object sender, EventArgs e)
    {
      Text405.Text = (&quot;&lt;b&gt;&quot; + ((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Credores.Qualificacao.Nome&quot;)) + &quot;&lt;/b&gt;: &quot; + ((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Credores.Nome&quot;)));
      
      if (((Int64)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Credores.Participante.Pessoa.NumeroDoDocumento&quot;)) &gt; 0)
        Text405.Text += (&quot; - &quot; + ((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Credores.Participante.Pessoa.TipoDeDocumento&quot;)) + &quot; &quot; + AplicarMascaraDeDocumento(((Int64)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Credores.Participante.Pessoa.NumeroDoDocumento&quot;)).ToString(), false)); 
    }

    private void Text14_AfterData(object sender, EventArgs e)
    {
      Text14.Text = &quot;&quot;; // (&quot;FOI CANCELADO em &quot; + (((DateTime)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DataDoCancelamento&quot;))).ToString(&quot;dd 'de' MMMM 'de' yyyy,&quot;)  + &quot; na forma do artigo 26, da Lei n°9.492, de 10/09/1997.&quot;); 
    }


    private void Data9_AfterData(object sender, EventArgs e)
    {
      if(Report.GetDataSource(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Devedores&quot;).RowCount &gt; 3){
        Data9.Visible = false;
        Data4.Visible = true;
      } else{
        Data9.Visible = true;
        Data4.Visible = false;
      }
    }

    private void Text461_AfterData(object sender, EventArgs e)
    {
      Text461.Text = ((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Devedores.Nome&quot;)) + &quot; - &quot; + (((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Devedores.Participante.Pessoa.TipoDeDocumento&quot;)) + &quot; &quot; + AplicarMascaraDeDocumento(((Int64)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Devedores.Participante.Pessoa.NumeroDoDocumento&quot;)).ToString(), false));  
    }

    private void Text385_AfterData(object sender, EventArgs e)
    {
      if(((DateTime)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoApontamento.Titulo.DataDeEmissao&quot;)).Year == 1753)
        Text385.Text = &quot;-&quot;;
    }

    private void Text2_AfterData(object sender, EventArgs e)
    {
      if(((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.VerbasTotais.NomeDaVerba&quot;)).Contains(&quot;Taxa de Fiscalização&quot;)){
        Text2.Text = &quot;TFJ&quot;; }
       
      else if(((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.VerbasTotais.NomeDaVerba&quot;)).Contains(&quot;Cancelamento da&quot;)){
        Text2.Text = &quot;CANC. DA DISTRIBUIÇÃO&quot;; }
        
      else if(((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.VerbasTotais.NomeDaVerba&quot;)).Contains(&quot;Taxa de Boleto&quot;))
        Data3.Visible = false;
      
      else{
        Text2.Text = ((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.VerbasTotais.NomeDaVerba&quot;));}
    } 

    private void Data3_AfterData(object sender, EventArgs e)
    {
      if(((String)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.VerbasTotais.NomeDaVerba&quot;)).Contains(&quot;Taxa de Boleto&quot;))
      {
         valorDaTaxaDeBoleto = ((Decimal)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.VerbasTotais.Valor&quot;));
      }
    } 

    private void Text8_AfterData(object sender, EventArgs e)
    {
      Text8.Text = &quot;&lt;b&gt;O TABELIÃO DO &quot; + ((String)Report.GetColumnValue(&quot;Dados.DadosDoCartorio.Nome&quot;))+ &quot; DA COMARCA DE CAMPO GRANDE-MS&lt;/b&gt;, no uso de suas atribuições legais, por este público instrumento, &lt;b&gt;CERTIFICA E DA FÉ&lt;/b&gt;, que, nos termos da Lei. n° 9.492 de 10 de setembro de 1997, &lt;b&gt;FOI CANCELADO&lt;/b&gt; em &quot; + ((DateTime)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DataDoCancelamento&quot;)).ToString(&quot;dd 'de' MMMM 'de' yyyy.&quot;) + &quot;, conforme processo n° &lt;b&gt;&quot; + ((Int32)Report.GetColumnValue(&quot;Dados.DadosDoItemPedido.DadosDoCancelamento.NumeroDoProcesso&quot;)) + &quot;&lt;/b&gt; a pedido de &quot; + ((String)Report.GetColumnValue(&quot;Dados.DadosDoPedido.Solicitante.Nome&quot;)) + &quot;, o registro de protesto abaixo descrito:&quot;;
        
    }
