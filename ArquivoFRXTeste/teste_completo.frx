<ScriptText><![CDATA[using System;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    // Caso 2 - Ref-3: método que EXISTE (não deve gerar erro)
    private void MetodoQueExiste(object sender, EventArgs e)
    {
    }

    // Caso 4 - Code-1: catch vazio
    private void TesteCode1(object sender, EventArgs e)
    {
      try { var x = 1; }
      catch { }
    }

    // Caso 5 - Code-2: casts inseguros (devem detectar)
    private void TesteCode2(object sender, EventArgs e)
    {
      bool ativo = (Boolean)Row["Ativo"];
      DateTime data = (DateTime)Row["Data"];
    }

    // Caso 6 - Code-2: SEGURO (não deve detectar)
    private void TesteCode2Seguro(object sender, EventArgs e)
    {
      bool ativo = Convert.ToBoolean(Row["Ativo"] ?? false);
      string nome = (string)Row["Nome"];
    }

    // Caso 7 - Code-4: deve detectar (modifica componente diferente)
    private void Text1_AfterData(object sender, EventArgs e)
    {
      Text3.Text = "valor errado";
      Text3.Visible = false;
    }

    // Caso 8 - Code-4: NÃO deve detectar (componente correto)
    private void Text2_AfterData(object sender, EventArgs e)
    {
      Text2.Text = "valor correto";
      Text2.Visible = true;
    }

    // Caso 9 - Code-4: NÃO deve detectar (propriedade não vigiada)
    private void Text4_AfterData(object sender, EventArgs e)
    {
      Text5.ForeColor = Color.Red;
    }

    // Caso 10 - Code-5: deve detectar (if sem else)
    private void Text10_AfterData(object sender, EventArgs e)
    {
      if (sender != null)
        Text10.Text = "CONDICIONAL";
      // sem else — Code-5 deve detectar
    }

    // Caso 11 - Code-5: NÃO deve detectar (if com else de reset)
    private void Text11_AfterData(object sender, EventArgs e)
    {
      if (sender != null)
        Text11.Text = "CONDICIONAL";
      else
        Text11.Text = string.Empty;
    }

    // Caso 12 - Code-5: deve detectar (else existe mas não reseta)
    private void Text12_AfterData(object sender, EventArgs e)
    {
      if (sender != null)
        Text12.Text = "CONDICIONAL";
      else
        Text12.Visible = false; // reseta Visible mas não Text — Code-5 para Text
    }
  }
}]]></ScriptText>
</Report>
