    private void Text14_AfterData(object sender, EventArgs e)
    {                         
      Text14.Text = (&quot;&lt;b&gt;&quot; + ((String)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDosCredores.Qualificacao&quot;)) + &quot;&lt;/b&gt;: &quot; + ((String)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDosCredores.Nome&quot;)));  
      
