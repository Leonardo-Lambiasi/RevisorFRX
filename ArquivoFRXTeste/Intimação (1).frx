    private void Text361_AfterData(object sender, EventArgs e)
    {                                                                                             
      Text361.Text = (
        &quot;&lt;font size=\&quot;7\&quot;&gt;&lt;b&gt;1.Boleto de Cobrança:&lt;/b&gt; Pagável em qualquer banco até o a data do vencimento.&quot;
        + &quot;\n&lt;b&gt;2.Na sede do Tabelionato:&lt;/b&gt; &quot;
        + &quot;\na) Pagamento em Dinheiro, embora &lt;b&gt;RECOMENDA-SE O USO DE OUTROS MEIOS DE PAGAMENTO,&lt;/b&gt; em virtude do &lt;b&gt;PERIGO&lt;/b&gt; apresentado pelo transporte de valores em espécie.&quot;
        + &quot;\nb) Pagamento em Cheque, o qual deverá ser \&quot;visado ou administrativo\&quot;, pagavel nesta \&quot;praça\&quot;, no valor de &lt;b&gt;R$ &quot; + ((Decimal)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoTitulo.ValorAProtestar&quot;)).ToString(&quot;N2&quot;) + &quot;&lt;/b&gt;, em nome do Portador acima.&quot;
        + &quot;\n&lt;b&gt;IMPORTANTE:&lt;/b&gt; O valor das custas e emolumentos (taxas cartórarias), no valor de &lt;b&gt;R$ &quot; + (((Decimal)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDasCustas.ValorTotalDasCustas&quot;)) + ((Decimal)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDasCustas.ValorTotalDeIntimacao&quot;)) + ((Decimal)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDasCustas.ValorTotalDeEdital&quot;))).ToString(&quot;N2&quot;) + &quot;&lt;/b&gt;, deverá ser paga no ato e em apartado (ESTE VALOR NÃO PODERÁ SER SOMADO AO CHEQUE).&quot;
        + &quot;\n&lt;b&gt;3. Intimação fora do Prazo:&lt;/b&gt; Se a intimação for entregue fora do prazo limite, o pagamento deverá ser feito no primeiro dia útil seguinte, diretamente no Tabelião.&quot;                               
        + &quot;\n&lt;b&gt;&lt;font size=\&quot;8\&quot;&gt;4. MICROEMPRESA E EPP: contate o Cartório para obter aproximadamente 33% de desconto na taxa de protesto, apresentando a certidão simplificada da JUCESP atualizada (art. 73 da L.C. 123/2006).&lt;/b&gt;&lt;/font&gt;&quot;
        + &quot;\n&lt;b&gt;ATENÇÃO:&lt;/b&gt; O registro do protesto será informado aos orgãos de proteção ao crédito, se por eles solicitados, nos termos do Art. 29 da Lei nº 9.492/1997.&lt;/font&gt;&quot;);          
    }                                                                                             
                                                                                                    
    private void Text29_AfterData(object sender, EventArgs e)                                                                                                                    
    {                  
      var documento = ((Int64)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoDevedor.NumeroDoDocumento&quot;)).ToString();
      var tipoDoc = (((String)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoDevedor.TipoDeDocumento&quot;)));  
      var docFormat = AplicarMascaraDeDocumento(tipoDoc, documento, false);
      Text29.Text = tipoDoc + &quot;: &quot; + docFormat; 
    } 
    
