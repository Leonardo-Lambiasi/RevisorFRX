    private void Text711_AfterData(object sender, EventArgs e)
    {
      if(((Int64)Report.GetColumnValue(&quot;Dados.DadosIntimacoes.Intimacao.DadosDoDevedor.TelefoneDoDevedor.NumeroDoTelefone&quot;)) != null)
